rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == 'admin';
    }

    match /user/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /userData/{uid} {
      // Chủ sở hữu đọc/ghi; admin được phép (để xóa khi thanh lý tài khoản)
      allow read, write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /sharedData/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    // Nhật ký hoạt động: ai cũng đọc được (admin/giáo viên tổng hợp);
    // mỗi người ghi nhật ký của chính mình, admin được ghi/xóa để quản lý.
    match /activities/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
  }
}
